{
  "name": "seaport",
  "private": true,
  "version": "0.1.0",
  "description": "The open-source Org OS for VPS — AI agents, org structure, and HR tools, self-hosted in 60 seconds.",
  "repository": {
    "type": "git",
    "url": "https://github.com/Seahawk-Media/seaport"
  },
  "keywords": ["org-os", "self-hosted", "ai-agents", "vps", "employee-management", "open-source"],
  "author": "Seahawk Media",
  "license": "MIT",
  "homepage": "https://github.com/Seahawk-Media/seaport#readme",
  "bugs": {
    "url": "https://github.com/Seahawk-Media/seaport/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite\" \"tsx watch server/index.ts\"",
    "dev:client": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "vite build && tsup server/index.ts --format esm --outDir dist/server",
    "start": "node dist/server/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview"
  },
  "dependencies": {
